# ==============================================================================
# HUBBHQ - UNIVERSAL STORAGE CONFIGURATION
# ==============================================================================
# HubbHQ mendukung integrasi penyimpanan terpadu untuk menyimpan foto profil,
# dokumen surat, lampiran nota keuangan, berkas LPJ, sertifikat, dan media kegiatan.
#
# Pilihan STORAGE_PROVIDER:
# - 'local'  : Menyimpan langsung di disk server lokal (Default)
# - 's3'     : S3-Compatible Storage (AWS S3, Cloudflare R2, MinIO, Wasabi, AList S3)
# - 'r2'     : Cloudflare R2 (Dedicated shorthand)
# - 'webdav' : WebDAV Storage (AList WebDAV, Nextcloud, OwnCloud, Synology)
# ==============================================================================

STORAGE_PROVIDER=local

# ------------------------------------------------------------------------------
# 1. LOCAL STORAGE SETTINGS (Default)
# ------------------------------------------------------------------------------
# Path relatif ke direktori root aplikasi tempat file disimpan secara lokal.
STORAGE_LOCAL_DIR=./uploads

# Folder yang dapat diakses publik langsung tanpa autentikasi session
STORAGE_PUBLIC_FOLDERS=images,documents,gallery,banners,post-images,library

# Folder yang wajib lewat proteksi session (/api/files/[folder]/[filename])
STORAGE_PROTECTED_FOLDERS=avatars,signatures,attachments,private,user-files,lpj,proposals


# ------------------------------------------------------------------------------
# 2. S3-COMPATIBLE STORAGE (AWS S3, MinIO, Wasabi, Backblaze B2)
# ------------------------------------------------------------------------------
# Aktifkan dengan menyetel: STORAGE_PROVIDER=s3

# S3_REGION=us-east-1
# S3_BUCKET=hubbhq-bucket
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Khusus MinIO, Ceph, atau Self-Hosted S3:
# S3_ENDPOINT=http://minio.local:9000
# S3_FORCE_PATH_STYLE=true

# Domain CDN publik opsional (misal CloudFront atau Custom Domain MinIO)
# S3_PUBLIC_URL=https://cdn.organisasi.id


# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 (Zero Egress Cost, S3 API)
# ------------------------------------------------------------------------------
# Aktifkan dengan menyetel: STORAGE_PROVIDER=r2

# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=hubbhq-r2
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Domain publik R2 (R2.dev subdomain atau custom domain di Cloudflare)
# R2_PUBLIC_URL=https://files.organisasi.id


# ------------------------------------------------------------------------------
# 4. ALIST S3 GATEWAY (Google Drive, OneDrive, Local, DropBox via AList)
# ------------------------------------------------------------------------------
# AList (https://github.com/AlistGo/alist) menyediakan S3 API gateway.
# Ini memungkinkan organisasi menghubungkan Google Drive, OneDrive, Mega, Terabox,
# maupun server file lain ke AList, lalu HubbHQ mengaksesnya sebagai S3 bucket.
#
# Langkah integrasi via S3:
# 1. Di AList, pastikan fitur S3 Gateway aktif (default port 5244).
# 2. Buat atau periksa access key di menu Settings -> S3 AList.
# 3. Masukkan konfigurasi berikut di HubbHQ:

# STORAGE_PROVIDER=s3
# S3_ENDPOINT=http://127.0.0.1:5244/api/fs/s3
# S3_REGION=auto
# S3_BUCKET=hubbhq
# S3_ACCESS_KEY_ID=your-alist-username-or-token
# S3_SECRET_ACCESS_KEY=your-alist-password-or-token
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=http://127.0.0.1:5244/d/hubbhq


# ------------------------------------------------------------------------------
# 5. WEBDAV STORAGE (AList WebDAV, Nextcloud, OwnCloud)
# ------------------------------------------------------------------------------
# Aktifkan dengan menyetel: STORAGE_PROVIDER=webdav
# HubbHQ akan melakukan upload, baca, dan kelola file via protokol WebDAV HTTP.

# Contoh koneksi ke AList WebDAV:
# WEBDAV_URL=http://127.0.0.1:5244/dav
# WEBDAV_USERNAME=admin
# WEBDAV_PASSWORD=your_alist_password
# WEBDAV_BASE_PATH=hubbhq
# WEBDAV_PUBLIC_URL=http://127.0.0.1:5244/d/hubbhq

# Contoh koneksi ke Nextcloud WebDAV:
# WEBDAV_URL=https://cloud.organisasi.id/remote.php/dav/files/admin
# WEBDAV_USERNAME=admin
# WEBDAV_PASSWORD=your_app_password
# WEBDAV_BASE_PATH=hubbhq-files
