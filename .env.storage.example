# ========================================================
# STORAGE CONFIGURATION
# ========================================================

# Storage Provider: 'local' | 's3' | 'r2'
# Default: 'local' (recommended for development)
STORAGE_PROVIDER=local

# Local Storage Settings
# Path relative to project root (where package.json is)
STORAGE_LOCAL_DIR=./uploads

# Folders accessible without authentication (comma-separated)
# Files in these folders are served publicly
STORAGE_PUBLIC_FOLDERS=images,documents,gallery,banners,post-images

# Folders that require authentication
# Files in these folders can ONLY be accessed via /api/files/[folder]/[filename]
STORAGE_PROTECTED_FOLDERS=avatars,signatures,attachments,private,user-files

# ========================================================
# S3 CONFIGURATION (Optional)
# ========================================================
# Only needed if STORAGE_PROVIDER=s3

# S3_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Optional: Custom endpoint for S3-compatible services (MinIO, etc.)
# S3_ENDPOINT=http://localhost:9000

# Optional: Custom CDN domain or public URL
# S3_PUBLIC_URL=https://cdn.yourdomain.com

# S3 public prefixes (paths that don't require auth)
# S3_PUBLIC_PREFIXES=images/,documents/,gallery/,banners/,post-images/

# ========================================================
# R2 CONFIGURATION (Optional - Cloudflare)
# ========================================================
# Only needed if STORAGE_PROVIDER=r2

# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=your-r2-bucket-name
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key

# Optional: Custom public URL (via Cloudflare Workers)
# R2_PUBLIC_URL=https://files.yourdomain.com

# R2 public prefixes
# R2_PUBLIC_PREFIXES=images/,documents/,gallery/,banners/,post-images/
