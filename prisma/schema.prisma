generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== CORE MODELS ====================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String?
  nickname       String?  // Nama panggilan
  fullName       String?  // Nama panjang
  birthPlace     String?  // Tempat lahir
  birthDate      DateTime? // Tanggal lahir
  address        String?  // Alamat
  phone          String?
  avatar         String?  // Foto profil
  signature      String?  // TTD digital
  isActive       Boolean  @default(true)
  emailVerified  DateTime?

  // KTA Digital (Kartu Tanda Anggota)
  nra            String?  @unique // Nomor Registrasi Anggota
  bloodType      String?  // Golongan Darah (A, B, AB, O)
  emergencyContact String? // Kontak darurat
  ktaIssuedAt    DateTime? // Tanggal terbit KTA
  ktaValidUntil  DateTime? // Masa berlaku KTA
  ktaCardUrl     String?  @db.Text // URL arsip render KTA digital

  // Password security
  mustChangePassword Boolean @default(false)  // Force password change on next login
  passwordChangedAt  DateTime?                // Track when password was last changed

  // Soft delete support
  deletedAt    DateTime?  // Soft delete timestamp

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  roleId         String?
  role           Role?    @relation(fields: [roleId], references: [id])
  wilayahId      String?
  wilayah        Wilayah? @relation(fields: [wilayahId], references: [id])
  jabatanId      String?
  jabatan        Jabatan? @relation(fields: [jabatanId], references: [id])

  // Divisi membership
  divisiMembers  DivisiMember[]

  // Program Kerja
  prokerPIC      ProgramKerja[] @relation("ProkerPIC")
  prokerCreated  ProgramKerja[] @relation("ProkerCreator")

  // Checkpoints
  checkpoints    Checkpoint[]

  // Keuangan
  kasPayments    KasPayment[]
  transactions   Transaction[]

  // Surat
  suratRequested Surat[] @relation("SuratRequester")
  suratApproved Surat[] @relation("SuratApprover")

  // Proposal Dana
  proposalDana     ProposalDana[]
  reviewedProposals ProposalDana[] @relation("ProposalReviewer")

  // Kalender
  calendarEvents CalendarEvent[]

  // Notification
  notifications  Notification[]

  // Auth
  accounts       Account[]
  sessions       Session[]

  // Audit logs
  auditLogs      AuditLog[]

  // Uploaded media files
  uploadedMedia  MediaFile[]

  // Panitia Proker
  panitiaProker  PanitiaProker[]

  // Proposal History Reviewed
  proposalHistoryReviewed ProposalHistory[]

  // LPJ Reviewed
  reviewedLpj    LpjProker[] @relation("LpjReviewer")
  lpjChecklistVerifications LpjProker[] @relation("LpjChecklistVerifier")

  // Presensi & Notula
  presensiCreated PresensiSesi[] @relation("PresensiCreator")
  presensiRecords PresensiKehadiran[] @relation("UserKehadiran")
  notulaDitulis   NotulaRapat[] @relation("NotulaNotulis")

  // Inventaris & Peminjaman Barang
  peminjamanBarang PeminjamanBarang[] @relation("PeminjamanUser")
  petugasPinjam    PeminjamanBarang[] @relation("PetugasPinjam")
  petugasKembali   PeminjamanBarang[] @relation("PetugasKembali")

  // Disposisi Surat Masuk
  disposisiDiterima  DisposisiSurat[] @relation("DisposisiPenerima")
  disposisiDiberikan DisposisiSurat[] @relation("DisposisiPemberi")

  // E-Voting Musyawarah / Mubes
  votingCreated     VotingEvent[] @relation("VotingCreator")
  votingDptEntries  VotingDPT[]   @relation("UserDpt")

  // Aspirasi & Advokasi
  aspirasiDitindakLanjut Aspirasi[] @relation("AspirasiPIC")
  aspirasiTanggapan      AspirasiTanggapan[]

  // Diklat & Kaderisasi
  jenjangKaderId         String?
  jenjangKader           KaderisasiJenjang? @relation(fields: [jenjangKaderId], references: [id])
  nrk                    String?            @unique // Nomor Registrasi Kader
  diklatPesertaEntries   DiklatPeserta[]

  // Alumni
  alumniProfile          Alumni?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token     String? @db.Text
  expires_at       Int?
  token_type       String?
  scope            String?
  id_token         String? @db.Text
  session_state    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==================== ROLE & PERMISSION ====================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // admin, bendahara, sekretaris, ketua, anggota, dll
  displayName String   // Nama tampilan
  description String?
  color       String   @default("#6366f1") // Warna untuk UI
  permissions Permission[]
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  name   String @unique // articles.create, articles.edit, dll
  label  String // Label untuk display
  group  String // Kategori: members, divisi, proker, keuangan, surat, dll
  roles  Role[]

  @@map("permissions")
}

// ==================== WILAYAH ====================

model Wilayah {
  id        String   @id @default(cuid())
  name      String   // Pusat, Korwil Jawa Barat, dll
  shortName String?  // PB, KWB, dll
  parentId  String?
  parent    Wilayah? @relation("WilayahHierarchy", fields: [parentId], references: [id])
  children  Wilayah[] @relation("WilayahHierarchy")
  level     Int      @default(0) // 0 = Pusat, 1 = Korwil, 2 = Korcam, dll
  isActive  Boolean  @default(true)
  users     User[]
  divisi    Divisi[] // Relasi ke divisi

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wilayah")
}

// ==================== JABATAN ====================

model Jabatan {
  id          String   @id @default(cuid())
  name        String   @unique // Ketua Umum, Wakil Ketua, Sekretaris Jenderal, dll
  shortName   String?  // Ketum, Waketum, Sekjen, dll
  level       Int      @default(0) // Level untuk sorting (semakin kecil semakin tinggi)
  isActive    Boolean  @default(true)
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("jabatan")
}

// ==================== DIVISI ====================

model Divisi {
  id          String   @id @default(cuid())
  name        String   @unique // nama divisi
  shortName   String?  // singkatan
  description String?  @db.Text
  color       String   @default("#6366f1")
  logo        String?  // URL logo divisi
  wilayahId   String?
  wilayah     Wilayah? @relation(fields: [wilayahId], references: [id])
  isActive    Boolean  @default(true)
  deletedAt   DateTime? // Soft delete timestamp

  members     DivisiMember[]
  programKerja ProgramKerja[]
  inventaris   InventarisBarang[]
  disposisi    DisposisiSurat[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("divisi")
}

model DivisiMember {
  id        String   @id @default(cuid())
  userId    String
  divisiId  String
  position  String?  // Ketua Divisi, Staff, dll
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  divisi    Divisi   @relation(fields: [divisiId], references: [id], onDelete: Cascade)

  @@unique([userId, divisiId])
  @@map("divisi_members")
}

// ==================== PROGRAM KERJA ====================

model ProgramKerja {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  divisiId    String
  divisi      Divisi   @relation(fields: [divisiId], references: [id], onDelete: Cascade)

  // PIC (Person In Charge)
  picId       String?
  pic         User?    @relation("ProkerPIC", fields: [picId], references: [id])

  creatorId   String
  creator     User     @relation("ProkerCreator", fields: [creatorId], references: [id])

  status      ProkerStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?

  // Standard Indonesian Organization Proker Fields
  kategori          String?       @default("INSIDENTAL") // RUTIN, INSIDENTAL, PRIORITAS
  sasaran           String?       @db.Text               // Target audiens / sasaran peserta
  indikator         String?       @db.Text               // Tolok ukur keberhasilan / KPI
  anggaranEstimasi  Decimal?      @db.Decimal(15, 2)     // Rencana Anggaran Biaya (RAB)
  sumberDana        String?                              // Kas Organisasi, Sponsor, Iuran, Donatur
  lokasi            String?                              // Lokasi pelaksanaan kegiatan

  // E-Sertifikat Kepanitiaan per Proker
  sertifikatTemplate    String?       @db.Text             // URL background template sertifikat proker
  sertifikatPrefix      String?                            // Pola nomor, cth: [NO]/SERT-OC/[DIVISI]/[KODE]/[BULAN]/[TAHUN]
  sertifikatSigner1Name String?                            // Nama penandatangan 1 (Ketua Pelaksana)
  sertifikatSigner1Role String?       @default("Ketua Pelaksana")
  sertifikatSigner2Name String?                            // Nama penandatangan 2 (Ketua Umum)
  sertifikatSigner2Role String?       @default("Ketua Umum")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkpoints    Checkpoint[]
  proposals      ProposalDana[]
  calendarEvents CalendarEvent[]
  panitia        PanitiaProker[]
  lpj            LpjProker?
  presensiSesi   PresensiSesi[]
  notulaRapat    NotulaRapat[]
  peminjamanBarang PeminjamanBarang[]
  oprecEvents    OprecEvent[]

  @@map("program_kerja")
}

enum ProkerStatus {
  DRAFT
  ON_PROGRESS
  COMPLETED
  CANCELLED
}

model PanitiaProker {
  id             String       @id @default(cuid())
  programKerjaId String
  programKerja   ProgramKerja @relation(fields: [programKerjaId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleJabatan    String       // e.g. "Ketua Pelaksana", "Sekretaris Panitia", "Bendahara Panitia", "Divisi Acara", "Divisi Humas & Publikasi", "Divisi Perlengkapan", "Divisi Konsumsi"
  nomorSertifikat       String?
  sertifikatUrl         String?      @db.Text
  sertifikatGeneratedAt DateTime?
  createdAt      DateTime     @default(now())

  @@unique([programKerjaId, userId, roleJabatan])
  @@map("panitia_proker")
}

model Checkpoint {
  id              String   @id @default(cuid())
  programKerjaId  String
  programKerja    ProgramKerja @relation(fields: [programKerjaId], references: [id], onDelete: Cascade)
  title           String
  description     String?  @db.Text
  isCompleted     Boolean  @default(false)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?    @relation(fields: [completedById], references: [id])
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("checkpoints")
}

// ==================== PROPOSAL DANA ====================

model ProposalDana {
  id          String   @id @default(cuid())
  programKerjaId String?
  programKerja ProgramKerja? @relation(fields: [programKerjaId], references: [id], onDelete: SetNull)

  title       String
  description String?  @db.Text
  amount      Decimal  @db.Decimal(15, 2)
  status      ProposalStatus @default(PENDING)
  version     Int      @default(1)

  requesterId String
  requester   User     @relation(fields: [requesterId], references: [id])

  reviewedById String?
  reviewedBy  User?    @relation("ProposalReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewedNote String?  @db.Text

  // File
  proposalFile   String?  // File proposal upload
  revisionFile    String?  // File revisian
  revisionNote    String?  @db.Text

  history         ProposalHistory[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("proposal_dana")
}

model ProposalHistory {
  id             String         @id @default(cuid())
  proposalDanaId String
  proposalDana   ProposalDana   @relation(fields: [proposalDanaId], references: [id], onDelete: Cascade)
  version        Int
  title          String
  description    String?        @db.Text
  amount         Decimal        @db.Decimal(15, 2)
  proposalFile   String?
  status         ProposalStatus
  reviewedNote   String?        @db.Text
  reviewedById   String?
  reviewedBy     User?          @relation(fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@map("proposal_history")
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
  REVISED
}

// ==================== LPJ (LAPORAN PERTANGGUNGJAWABAN) ====================

model LpjProker {
  id                 String       @id @default(cuid())
  programKerjaId     String       @unique
  programKerja       ProgramKerja @relation(fields: [programKerjaId], references: [id], onDelete: Cascade)
  ringkasanKegiatan  String?      @db.Text
  pesertaHadir       Int?         @default(0)
  ketercapaianTarget String?      @db.Text
  kendala            String?      @db.Text
  solusi             String?      @db.Text
  rekomendasi        String?      @db.Text
  totalPemasukan     Decimal      @default(0) @db.Decimal(15, 2)
  totalPengeluaran   Decimal      @default(0) @db.Decimal(15, 2)
  saldoAkhir         Decimal      @default(0) @db.Decimal(15, 2)
  status             LpjStatus    @default(DRAFT)
  reviewedById       String?
  reviewedBy         User?        @relation("LpjReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  reviewedNote       String?      @db.Text
  dokumenFinalLpj    String?      @db.Text // URL berkas final buku LPJ lengkap / scan PDF pengesahan
  dokumenFinalName   String?      // Nama berkas file final LPJ

  // Rekonsiliasi Surplus & Alokasi Dana (KEMBALIKAN_KAS_UMUM, KAS_DIVISI, SYUKURAN_PANITIA, BAGI_HASIL, NONE)
  surplusAction          String?
  surplusNote            String?      @db.Text
  surplusAmount          Decimal?     @default(0) @db.Decimal(15, 2)
  isSurplusSettled       Boolean      @default(false)

  // Checklist Kelaikan Berkas Fisik Pra-Sidang LPJ (Compliance Audit Gate)
  checklistNotaFisik     Boolean      @default(false)
  checklistPresensi      Boolean      @default(false)
  checklistDokumentasi   Boolean      @default(false)
  checklistBeritaAcara   Boolean      @default(false)
  checklistVerifiedById  String?
  checklistVerifiedBy    User?        @relation("LpjChecklistVerifier", fields: [checklistVerifiedById], references: [id])
  checklistVerifiedAt    DateTime?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  items              LpjItem[]

  @@map("lpj_proker")
}

enum LpjStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model LpjItem {
  id          String      @id @default(cuid())
  lpjId       String
  lpj         LpjProker   @relation(fields: [lpjId], references: [id], onDelete: Cascade)
  type        LpjItemType @default(EXPENSE) // INCOME (Pemasukan) atau EXPENSE (Pengeluaran)
  kategori    String      // e.g. "Konsumsi", "Kesekretariatan", "Perlengkapan", "Humas & Publikasi", "Transportasi/Akomodasi", "Sponsorship", "Pendaftaran"
  namaBarang  String
  qty         Decimal     @default(1) @db.Decimal(10, 2)
  satuan      String?     @default("item")
  hargaSatuan Decimal     @db.Decimal(15, 2)
  totalHarga  Decimal     @db.Decimal(15, 2)
  buktiNota   String?     // URL gambar bukti nota/struk/kuitansi
  keterangan  String?     @db.Text
  sumberDana  String?     @default("DANA_AJUAN") // DANA_AJUAN, KAS_PROKER, DANA_LUAR
  createdAt   DateTime    @default(now())

  @@map("lpj_items")
}

enum LpjItemType {
  INCOME
  EXPENSE
}

// ==================== PRESENSI DIGITAL & NOTULA RAPAT ====================

model PresensiSesi {
  id                  String              @id @default(cuid())
  programKerjaId      String
  programKerja        ProgramKerja        @relation(fields: [programKerjaId], references: [id], onDelete: Cascade)
  judul               String              // e.g. "Rapat Perdana Panitia", "Briefing Gladi Bersih", "Presensi Peserta Seminar"
  tipe                String              @default("RAPAT") // RAPAT, KEGIATAN, EVALUASI
  deskripsi           String?             @db.Text
  lokasi              String?
  tanggal             DateTime            @default(now())
  qrSecret            String              // Secret unik untuk HMAC QR dinamis
  currentQrToken      String?             // Token dinamis saat ini
  tokenRotatedAt      DateTime?           // Waktu rotasi token
  tokenTtlSeconds     Int                 @default(20) // Rotasi setiap 20 detik
  isActive            Boolean             @default(true)
  allowManualCheckin  Boolean             @default(true)
  isDitarikKeLpj      Boolean             @default(true) // Otomatis dilampirkan ke rekap LPJ
  createdById         String?
  createdBy           User?               @relation("PresensiCreator", fields: [createdById], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  kehadiran           PresensiKehadiran[]
  notulaList          NotulaRapat[]

  @@map("presensi_sesi")
}

model PresensiKehadiran {
  id             String         @id @default(cuid())
  presensiSesiId String
  presensiSesi   PresensiSesi   @relation(fields: [presensiSesiId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation("UserKehadiran", fields: [userId], references: [id], onDelete: Cascade)
  namaPeserta    String
  nomorIdentitas String?        // NIM / NIK / No. Anggota
  instansi       String?        // Divisi atau Institusi Asal
  status         PresensiStatus @default(HADIR)
  metodeScan     String         @default("QR_SCAN") // QR_SCAN, MANUAL_PANITIA, SELF_PORTAL
  keterangan     String?        @db.Text
  waktuHadir     DateTime       @default(now())

  @@unique([presensiSesiId, userId])
  @@map("presensi_kehadiran")
}

enum PresensiStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
}

model NotulaRapat {
  id             String        @id @default(cuid())
  programKerjaId String
  programKerja   ProgramKerja  @relation(fields: [programKerjaId], references: [id], onDelete: Cascade)
  presensiSesiId String?
  presensiSesi   PresensiSesi? @relation(fields: [presensiSesiId], references: [id], onDelete: SetNull)
  judul          String        // e.g. "Notula Rapat Koordinasi Panitia #1"
  tanggal        DateTime      @default(now())
  tempat         String?
  pimpinanRapat  String        // Nama pimpinan rapat / pimpinan sidang
  notulisId      String?
  notulis        User?         @relation("NotulaNotulis", fields: [notulisId], references: [id])
  notulisName    String?       // Nama cadangan jika notulis tamu/eksternal
  agenda         String?       @db.Text
  pembahasan     String        @db.Text // Uraian jalannya rapat
  kesimpulan     String        @db.Text // Keputusan / hasil pleno
  actionItems    String?       @db.Text // JSON daftar PIC dan deadline tugas
  lampiranUrl    String?       @db.Text // Tautan foto dokumentasi atau lampiran
  isDitarikKeLpj Boolean       @default(true) // Otomatis dilampirkan ke dokumen LPJ
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("notula_rapat")
}

// ==================== INVENTARIS & LOGISTIK SEKRETARIAT ====================

model InventarisBarang {
  id                String            @id @default(cuid())
  kodeBarang        String            @unique // e.g. "INV-ELEC-0001", "AST-2026-005"
  namaBarang        String            // e.g. "Proyektor Epson EB-X400", "Sound Portable Wireless Ashley"
  kategori          String            // Elektronik, Perlengkapan, ATK, Dokumentasi, Properti
  merkModel         String?           // Merk / tipe
  serialNumber      String?           // No. Seri dari pabrikan
  jumlahTotal       Int               @default(1)
  jumlahTersedia    Int               @default(1)
  jumlahDipinjam    Int               @default(0)
  jumlahRusak       Int               @default(0)
  satuan            String            @default("Unit") // Unit, Buah, Set, Pcs, Roll, Box
  kondisi           KondisiBarang     @default(BAIK)
  lokasiPenyimpanan String            // e.g. "Lemari Kaca A Sekretariat", "Gudang Logistik"
  asalPengadaan     String?           // e.g. "Pengadaan Kas Umum 2024", "Hibah Alumni"
  tanggalPengadaan  DateTime?
  hargaBeli         Decimal?          @db.Decimal(15, 2)
  fotoBarang        String?           @db.Text
  catatan           String?           @db.Text

  divisiId          String?
  divisi            Divisi?           @relation(fields: [divisiId], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  peminjaman        PeminjamanBarang[]

  @@map("inventaris_barang")
}

enum KondisiBarang {
  BAIK
  PERLU_PERBAIKAN
  RUSAK_BERAT
  HILANG
}

model PeminjamanBarang {
  id               String            @id @default(cuid())
  kodePeminjaman   String            @unique // e.g. "PINJAM-2026-0001"
  barangId         String
  barang           InventarisBarang  @relation(fields: [barangId], references: [id], onDelete: Cascade)
  jumlah           Int               @default(1)

  peminjamType     String            @default("ANGGOTA") // "ANGGOTA" atau "EKSTERNAL"
  userId           String?
  user             User?             @relation("PeminjamanUser", fields: [userId], references: [id], onDelete: SetNull)
  namaPeminjam     String
  kontakPeminjam   String            // No. Telepon / WhatsApp
  instansiPeminjam String?           // Divisi, Panitia Proker, atau Nama Organisasi Luar
  nomorIdentitas   String?           // NIM / NIK / No. Anggota

  keperluan        String            @db.Text
  programKerjaId   String?
  programKerja     ProgramKerja?     @relation(fields: [programKerjaId], references: [id], onDelete: SetNull)

  tanggalPinjam    DateTime          @default(now())
  rencanaKembali   DateTime
  tanggalKembali   DateTime?

  status           PeminjamanStatus  @default(DIPINJAM)
  kondisiPinjam    KondisiBarang     @default(BAIK)
  kondisiKembali   KondisiBarang?
  catatanKembali   String?           @db.Text

  petugasPinjamId  String?
  petugasPinjam    User?             @relation("PetugasPinjam", fields: [petugasPinjamId], references: [id], onDelete: SetNull)
  petugasKembaliId String?
  petugasKembali   User?             @relation("PetugasKembali", fields: [petugasKembaliId], references: [id], onDelete: SetNull)

  buktiFotoPinjam  String?           @db.Text
  buktiFotoKembali String?           @db.Text
  suratPeminjaman  String?           @db.Text

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("peminjaman_barang")
}

enum PeminjamanStatus {
  DIPINJAM
  DIKEMBALIKAN
  TERLAMBAT
  HILANG_RUSAK
}

// ==================== KEUANGAN ====================

model Transaction {
  id          String   @id @default(cuid())
  type        TransactionType
  category    String   // kas_anggota, sumbangan, bisnis, operasional, dll
  amount      Decimal  @db.Decimal(15, 2)
  description String?  @db.Text
  date        DateTime @default(now())

  // Bukti transfer
  receipt     String?  // URL file receipt
  receiptType String?  // image/jpeg, application/pdf

  // Untuk pemasukan dari kas anggota
  kasPaymentId String? @unique
  kasPayment   KasPayment? @relation(fields: [kasPaymentId], references: [id])

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  status      TransactionStatus @default(PENDING)

  // Optimistic Concurrency Control
  version     Int      @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

model KasPayment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       Int      // 1-12
  year        Int
  amount      Decimal  @db.Decimal(15, 2)
  proof       String?  // URL bukti transfer
  proofType   String?  // image/jpeg, application/pdf
  notes       String?  @db.Text
  status      KasStatus @default(PENDING)

  // Pembayaran QRIS & Gateway
  paymentMethod String?  @default("MANUAL") // GATEWAY_QRIS, MANDIRI_QRIS, MANUAL
  paymentRef    String?  // ID Order / Reference unik dari Gateway atau kode unik
  qrisString    String?  @db.Text // Payload QRIS dinamis
  paidAmount    Decimal? @db.Decimal(15, 2)
  paidAt        DateTime?

  transaction Transaction?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, month, year])
  @@map("kas_payments")
}

enum KasStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== KALENDER ====================

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(true)
  location    String?

  // Dari proker atau manual
  programKerjaId String?
  programKerja   ProgramKerja? @relation(fields: [programKerjaId], references: [id], onDelete: SetNull)

  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])

  color       String   @default("#6366f1")
  isPublic    Boolean  @default(true) // Visible di public website

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("calendar_events")
}

// ==================== SURAT ====================

model Surat {
  id              String   @id @default(cuid())
  type            SuratType
  letterNumber    String?  // Nomor surat
  subject         String
  content         String?  @db.Text

  // Metadata
  requesterId     String?
  requester       User?    @relation("SuratRequester", fields: [requesterId], references: [id])

  approverId      String?
  approver        User?    @relation("SuratApprover", fields: [approverId], references: [id])
  approvedAt      DateTime?

  status          SuratStatus @default(DRAFT)

  // Files
  fileUrl         String?  // File surat yang sudah digenerate
  attachments     String?  // JSON array of attachment URLs

  // Untuk surat masuk
  sender          String?  // Pengirim surat masuk
  senderContact   String?  // Kontak pengirim
  receivedDate    DateTime?

  // Form data (JSON dari form dinamis)
  formData        Json?

  // Jenis surat
  jenisSuratId    String?
  jenisSurat      JenisSurat? @relation(fields: [jenisSuratId], references: [id])

  // QR Code
  qrCodeUrl       String?

  // Disposisi surat masuk
  disposisi       DisposisiSurat[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("surat")
}

enum SuratType {
  MASUK
  KELUAR
}

enum SuratStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model JenisSurat {
  id            String   @id @default(cuid())
  name          String   // Surat Keterangan, Surat Undangan, dll
  code          String   @unique // SK, SU, SD, dll
  templateUrl   String?  // Template file
  formSchema    Json?    // JSON Schema untuk form
  autoNumber    Boolean  @default(true)
  numberPrefix  String?  // Prefix nomor surat
  numberFormat  String?  // Format nomor: {prefix}/{month}/{year}/{number}

  isActive      Boolean  @default(true)
  surat         Surat[]
  templates     SuratTemplate[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("jenis_surat")
}

model SuratTemplate {
  id          String   @id @default(cuid())
  name        String
  fileUrl     String
  jenisSuratId String?
  jenisSurat  JenisSurat? @relation(fields: [jenisSuratId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedAt   DateTime @default(now())

  isActive    Boolean  @default(true)

  @@map("surat_templates")
}

// ==================== DISPOSISI SURAT MASUK ====================

model DisposisiSurat {
  id                   String            @id @default(cuid())
  suratId              String
  surat                Surat             @relation(fields: [suratId], references: [id], onDelete: Cascade)

  nomorAgenda          String?           // e.g. "042/AGD/2026"
  sifat                SifatDisposisi    @default(BIASA)

  tujuanDivisiId       String?
  tujuanDivisi         Divisi?           @relation(fields: [tujuanDivisiId], references: [id], onDelete: SetNull)
  tujuanUserId         String?
  tujuanUser           User?             @relation("DisposisiPenerima", fields: [tujuanUserId], references: [id], onDelete: SetNull)
  tujuanCustom         String?           // Misal: "Ketua Panitia Milad", "Bendahara Umum"

  instruksi            String            // JSON string array e.g. '["TINDAKLANJUTI","HADIRI_WAKILI"]'
  catatanPimpinan      String?           @db.Text

  batasWaktu           DateTime?         // Target tanggal selesai

  pemberiId            String?
  pemberi              User?             @relation("DisposisiPemberi", fields: [pemberiId], references: [id], onDelete: SetNull)
  pemberiNama          String?           // e.g. "Ketua Umum"
  pemberiJabatan       String?           // e.g. "Ketua Umum BPH"

  status               StatusDisposisi   @default(BELUM_DIPROSES)
  catatanTindakLanjut  String?           @db.Text
  tglSelesai           DateTime?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@map("disposisi_surat")
}

enum SifatDisposisi {
  SANGAT_SEGERA
  SEGERA
  BIASA
  RAHASIA
}

enum StatusDisposisi {
  BELUM_DIPROSES
  SEDANG_DIPROSES
  SELESAI
}

// ==================== NOTIFIKASI ====================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String   @db.Text
  type        NotificationType @default(INFO)
  link        String?  // Link untuk navigasi
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ==================== LIBRARY ====================

model LibraryBook {
  id          String   @id @default(cuid())
  title       String
  author      String?
  description String?  @db.Text
  coverUrl    String?
  fileUrl     String   // URL ke file PDF/EPUB
  fileType    String   // application/pdf, application/epub+zip
  fileSize    Int?     // Size in bytes
  category    String?  // Kategori buku
  tags        String?  // Tags (comma-separated)

  uploadedById String?
  uploadedAt   DateTime @default(now())

  viewCount   Int      @default(0)
  downloadCount Int    @default(0)

  isActive    Boolean  @default(true)

  @@map("library_books")
}

// ==================== WEBSITE CONFIG ====================

model WebsiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json     // Flexible value storage
  description String?
  category    String   @default("general") // general, appearance, social, contact
  isPublic    Boolean  @default(false)    // Can be accessed without auth

  updatedAt   DateTime @updatedAt

  @@map("website_config")
}

// ==================== ORGANIZATIONAL CHART ====================

model OrganizationalChart {
  id          String   @id @default(cuid())
  title       String
  level       Int      @default(0)
  userId      String?
  position    String?  // Nama posisi
  parentId    String?
  parent      OrganizationalChart? @relation("ChartHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    OrganizationalChart[] @relation("ChartHierarchy")

  wilayahId   String?
  divisiId    String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("organizational_chart")
}

// ==================== DOCUMENT (HUKUM) ====================

model Document {
  id          String   @id @default(cuid())
  title       String
  category    String   // AD/ART, SK, dll
  description String?  @db.Text
  fileUrl     String
  fileType    String?
  fileSize    Int?

  uploadedById String?
  uploadedAt   DateTime @default(now())

  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)

  @@map("documents")
}

// ==================== WEBSITE BUILDER (CMS) ====================

// Theme yang terinstal
model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  version     String   @default("1.0.0")
  description String?
  author      String?
  thumbnail   String?
  config      Json     // sections definition, layouts
  css         String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages       Page[]

  @@map("themes")
}

// Page (halaman publik)
model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  type        String   @default("page") // page, home, contact
  themeId     String?
  theme       Theme?   @relation(fields: [themeId], references: [id])
  isPublished Boolean  @default(false)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    PageSection[]

  @@map("pages")
}

// Section dalam page + konfigurasinya
model PageSection {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionKey  String   // identifier section (hero, about, dll)
  title       String?
  config      Json     // section-specific config
  content     String?  @db.LongText // HTML/markdown content for rich text
  order       Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageId, order])
  @@map("page_sections")
}

// ==================== WEBSITE CMS CONTENT (POST) ====================

// Status workflow untuk konten CMS
// DRAFT -> REVIEW -> PUBLISHED
// atau DRAFT -> REVIEW -> REVISION -> REVIEW -> PUBLISHED
// atau PUBLISHED -> ARCHIVED -> PUBLISHED

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?  @default("#6366f1")
  icon        String?  // Emoji atau icon name
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.LongText
  excerpt     String?

  // Featured image dengan media management
  featuredImage String?
  featuredImageId String?  // Reference ke MediaFile
  featuredAlt     String?  // Alt text untuk accessibility

  category    String?
  tags        String?

  // Workflow Status
  status      PostStatus @default(DRAFT)

  // Timestamps
  publishedAt DateTime?

  // Author
  authorId    String?
  authorName  String?  // Untuk guest authors

  // Review workflow
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote  String?  @db.Text // Catatan dari reviewer

  // SEO
  seoTitle    String?
  seoDesc     String?

  // Visibility
  isFeatured  Boolean  @default(false)  // Tampilkan di homepage
  isSticky    Boolean  @default(false)   // Sticky di top

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}

enum PostStatus {
  DRAFT       // Masih diedit, belum dikirim review
  REVIEW      // Sedang menunggu review
  REVISION    // Dikembalikan untuk direvisi
  PUBLISHED   // Sudah dipublish
  ARCHIVED    // Diarsipkan, tidak terlihat publik
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  album       String?
  imageUrl    String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("galleries")
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.LongText
  category    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

// ==================== NEWSLETTER ====================

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  isActive    Boolean  @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  ipAddress   String?

  @@map("newsletter_subscribers")
}

// ==================== WEBSITE MENU ====================

model MenuItem {
  id          String   @id @default(cuid())
  label       String   // Label yang ditampilkan
  href        String   // URL/path
  icon        String?  // Icon (emoji atau lucide icon name)
  order       Int      @default(0) // Urutan di menu
  parentId    String?  // Untuk submenu
  parent      MenuItem? @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuHierarchy")
  isActive    Boolean  @default(true)
  isExternal  Boolean  @default(false) // Buka di tab baru
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId, order])
  @@map("menu_items")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // CREATE, UPDATE, DELETE, VIEW, LOGIN, LOGOUT, dll
  entity      String   // USER, SURAT, TRANSACTION, dll
  entityId    String?
  details     Json?    // Detail perubahan (old/new values)
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== MEDIA FILES ====================

model MediaFile {
  id           String   @id @default(cuid())
  filename     String   // Generated filename
  originalName String   // Original uploaded name
  mimeType     String   // MIME type
  size         Int      // Size in bytes
  url          String   // URL/path to file
  folder       String?  // Optional folder grouping

  // Access control
  isPublic     Boolean  @default(false)  // Can be accessed without auth

  metadata     Json?    // Additional metadata (dimensions, duration, etc.)

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder])
  @@index([mimeType])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([isPublic])
  @@map("media_files")
}

// ==================== JOB QUEUE ====================

model QueueJob {
  id           String   @id // Custom ID format: job_timestamp_random
  name         String   // Job type: email, export, sync, etc.
  data         Json     // Job payload
  status       String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, RETRY
  priority     String   @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  attempts     Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?  // Last error message
  result      Json?    // Job result on completion
  scheduledFor DateTime? // Optional scheduled time

  completedAt DateTime?
  failedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([name, status])
  @@map("queue_jobs")
}

// ==================== E-VOTING MUSYAWARAH / MUBES ====================

model VotingEvent {
  id              String            @id @default(cuid())
  title           String            // e.g. "Pemilihan Ketua Umum MUBES XV HubbHQ"
  slug            String            @unique // e.g. "mubes-xv-ketum"
  description     String?           @db.Text
  rules           String?           @db.Text // Tata tertib pemilihan / konsideran pleno
  startDate       DateTime
  endDate         DateTime
  status          VotingStatus      @default(DRAFT)
  showLiveCount   Boolean           @default(true) // Tampilkan grafik perolehan langsung di layar proyektor
  allowAbstain    Boolean           @default(false) // Mengizinkan kotak kosong / abstain

  createdById     String?
  createdBy       User?             @relation("VotingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  kandidat        VotingKandidat[]
  dpt             VotingDPT[]
  ballots         VotingBallot[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("voting_events")
}

enum VotingStatus {
  DRAFT
  AKTIF
  SELESAI
  DIBATALKAN
}

model VotingKandidat {
  id              String            @id @default(cuid())
  votingEventId   String
  votingEvent     VotingEvent       @relation(fields: [votingEventId], references: [id], onDelete: Cascade)

  nomorUrut       Int
  namaKetua       String
  namaWakil       String?
  fotoUrl         String?           @db.Text
  visi            String?           @db.Text
  misi            String?           @db.Text
  programUnggulan String?           @db.Text
  suaraSah        Int               @default(0)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([votingEventId, nomorUrut])
  @@map("voting_kandidat")
}

model VotingDPT {
  id              String            @id @default(cuid())
  votingEventId   String
  votingEvent     VotingEvent       @relation(fields: [votingEventId], references: [id], onDelete: Cascade)

  userId          String?
  user            User?             @relation("UserDpt", fields: [userId], references: [id], onDelete: SetNull)

  nama            String
  nraOrNim        String?
  emailOrPhone    String?
  votingToken     String            @unique // Token rahasia sekali pakai untuk mencoblos di bilik suara
  hasVoted        Boolean           @default(false)
  votedAt         DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([votingEventId, userId])
  @@index([votingEventId, hasVoted])
  @@map("voting_dpt")
}

model VotingBallot {
  id               String           @id @default(cuid())
  votingEventId    String
  votingEvent      VotingEvent      @relation(fields: [votingEventId], references: [id], onDelete: Cascade)

  kandidatId       String?          // null jika memilih abstain / kotak kosong
  hashVerification String           // Hash unik (SHA-256) bukti integritas kotak suara anonim
  timestamp        DateTime         @default(now())

  @@index([votingEventId, kandidatId])
  @@map("voting_ballots")
}

// ==================== ASPIRASI & ADVOKASI MAHASISWA / WARGA ====================

enum AspirasiKategori {
  FASILITAS
  AKADEMIK_UKT
  KEBIJAKAN
  KEAMANAN_PERUNDUNGAN
  SARAN_UMUM
}

enum AspirasiStatus {
  MENUNGGU
  DIVERIFIKASI
  DALAM_ADVOKASI
  SELESAI
  DITOLAK
}

enum AspirasiUrgensi {
  RENDAH
  SEDANG
  TINGGI
  DARURAT
}

model Aspirasi {
  id                   String             @id @default(cuid())
  kodeTiket            String             @unique // e.g. "ASP-2026-0001"
  pinPelacak           String             // PIN 6 digit untuk pelapor publik melacak status aduan
  judul                String
  kategori             AspirasiKategori
  isi                  String             @db.Text
  isAnonim             Boolean            @default(true)
  namaPelapor          String?
  kontakPelapor        String?
  lampiranUrl          String?            @db.Text
  status               AspirasiStatus     @default(MENUNGGU)
  urgensi              AspirasiUrgensi    @default(SEDANG)
  tindakLanjut         String?            @db.Text // Tanggapan resmi yang dapat dibaca pelapor
  catatanInternal      String?            @db.Text // Catatan rahasia pengurus advokasi
  ditindakLanjutOlehId String?
  ditindakLanjutOleh   User?              @relation("AspirasiPIC", fields: [ditindakLanjutOlehId], references: [id], onDelete: SetNull)
  tanggalSelesai       DateTime?
  tanggapan            AspirasiTanggapan[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, kategori])
  @@map("aspirasi")
}

model AspirasiTanggapan {
  id         String   @id @default(cuid())
  aspirasiId String
  aspirasi   Aspirasi @relation(fields: [aspirasiId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  pengirim   String   // "PENGURUS" atau "PELAPOR"
  pesan      String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("aspirasi_tanggapan")
}

// ==================== DIKLAT & JENJANG KADERISASI ====================

enum DiklatStatus {
  DRAFT
  PENDAFTARAN
  BERJALAN
  SELESAI
  DIBATALKAN
}

enum ScreeningStatus {
  PENDING
  LOLOS
  GAGAL
}

enum KelulusanStatus {
  BELUM_DITETAPKAN
  LULUS_MURNI
  LULUS_BERSYARAT
  TIDAK_LULUS
}

model KaderisasiJenjang {
  id                   String         @id @default(cuid())
  urutan               Int            @unique // 1, 2, 3...
  namaJenjang          String         // e.g. "Kader Dasar (LK 1 / Mapaba / LDKM)"
  singkatan            String         // e.g. "LK 1"
  deskripsi            String?        @db.Text
  syaratKelulusan      String?        @db.Text
  minBulanMenujuLanjut  Int            @default(0)
  isActive             Boolean        @default(true)
  kader                User[]
  batch                DiklatBatch[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("kaderisasi_jenjang")
}

model DiklatBatch {
  id               String            @id @default(cuid())
  jenjangId        String
  jenjang          KaderisasiJenjang @relation(fields: [jenjangId], references: [id], onDelete: Restrict)
  kodeBatch        String            @unique // e.g. "LK1-2026-01"
  namaDiklat       String            // e.g. "Latihan Kader 1 Angkatan XXV"
  tanggalMulai     DateTime
  tanggalSelesai   DateTime
  lokasi           String
  biayaPendaftaran Decimal           @default(0) @db.Decimal(12, 2)
  kuota            Int               @default(50)
  status           DiklatStatus      @default(DRAFT)
  motNama          String?           // Master of Training / Koordinator
  skKepanitiaan    String?
  peserta          DiklatPeserta[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("diklat_batch")
}

model DiklatPeserta {
  id                   String          @id @default(cuid())
  batchId              String
  batch                DiklatBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  namaLengkap          String
  nraOrNim             String?
  instansiAsal         String?
  kontak               String?
  esaiUrl              String?         @db.Text
  statusScreening      ScreeningStatus @default(PENDING)
  nilaiKognitif        Float           @default(0)
  nilaiAfektif         Float           @default(0)
  nilaiPsikomotorik    Float           @default(0)
  nilaiAkhir           Float           @default(0)
  statusKelulusan      KelulusanStatus @default(BELUM_DITETAPKAN)
  nomorRegistrasiKader String?         @unique
  nomorSttpp           String?         @unique
  sttppIssuedAt        DateTime?
  catatanInstruktur    String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([batchId, statusKelulusan])
  @@map("diklat_peserta")
}

// ==================== ALUMNI & DANA ABADI ====================

enum AlumniProgramDonasi {
  DANA_ABADI
  BEASISWA_KADER
  RENOVASI_SEKRETARIAT
  TANGGAP_BENCANA
  SPONSOR_ACARA
}

enum AlumniDonasiStatus {
  PENDING
  TERVERIFIKASI
  BATAL
}

model Alumni {
  id                 String          @id @default(cuid())
  userId             String?         @unique
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  nama               String
  angkatanMasuk      Int
  tahunLulus         Int
  jabatanTerakhir    String?
  profesi            String?
  instansiBekerja    String?
  email              String?
  phone              String?
  domisili           String?
  linkedin           String?
  bio                String?         @db.Text
  isKontributorAktif Boolean         @default(false)
  donasi             AlumniDonasi[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tahunLulus, angkatanMasuk])
  @@map("alumni")
}

model AlumniDonasi {
  id             String               @id @default(cuid())
  alumniId       String?
  alumni         Alumni?              @relation(fields: [alumniId], references: [id], onDelete: SetNull)
  namaDonatur    String
  nominal        Decimal              @db.Decimal(12, 2)
  programDonasi  AlumniProgramDonasi  @default(DANA_ABADI)
  metodeBayar    String               @default("QRIS")
  referensiBayar String?
  status         AlumniDonasiStatus   @default(PENDING)
  catatan        String?              @db.Text
  pesanAlumni    String?              @db.Text
  tanggalBayar   DateTime             @default(now())
  createdAt      DateTime             @default(now())

  @@index([programDonasi, status])
  @@map("alumni_donasi")
}

// ==================== PERSIDANGAN & TAP MUBES ====================

enum SidangStatus {
  PERSIAPAN
  BERLANGSUNG
  SKORSING
  DITUTUP
}

model SidangMusyawarah {
  id             String            @id @default(cuid())
  namaMusyawarah String            // e.g. "Musyawarah Besar XXIV / Kongres"
  tema           String?           @db.Text
  tempat         String
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  presidium1     String?
  presidium2     String?
  presidium3     String?
  status         SidangStatus      @default(PERSIAPAN)
  totalKuorum    Int               @default(0)
  kuorumTercapai Boolean           @default(false)
  risalah        SidangRisalah[]
  ketetapanSK    SidangKetetapanSK[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("sidang_musyawarah")
}

model SidangRisalah {
  id                   String           @id @default(cuid())
  sidangId             String
  sidang               SidangMusyawarah @relation(fields: [sidangId], references: [id], onDelete: Cascade)
  agenda               String           // e.g. "Sidang Pleno I: Tata Tertib"
  waktuMulai           DateTime
  waktuSelesai         DateTime?
  isiRisalah           String           @db.Text
  interupsiDanDinamika String?          @db.Text
  notulisNama          String
  createdAt            DateTime         @default(now())

  @@map("sidang_risalah")
}

model SidangKetetapanSK {
  id                     String           @id @default(cuid())
  sidangId               String
  sidang                 SidangMusyawarah @relation(fields: [sidangId], references: [id], onDelete: Cascade)
  nomorTap               String           @unique // e.g. "TAP. 04/MUBES-XXIV/2026"
  tentang                String           @db.Text
  konsideranMenimbang    String           @db.Text
  konsideranMengingat    String           @db.Text
  konsideranMemperhatikan String          @db.Text
  diktumMemutuskan       String           @db.Text
  diktumMenetapkan       String           @db.Text
  tanggalDitetapkan      DateTime
  tempatDitetapkan       String
  isDisahkan             Boolean          @default(true)
  pdfUrl                 String?          @db.Text
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@map("sidang_ketetapan_sk")
}

// ==================== OPEN RECRUITMENT (OPREC) TERPADU ====================

enum OprecTipe {
  PENGURUS_BARU
  PANITIA_EVENT
}

enum OprecTahap {
  BERKAS_PENDING
  BERKAS_LOLOS
  BERKAS_GAGAL
  WAWANCARA
  LULUS
  DITOLAK
}

model OprecEvent {
  id               String           @id @default(cuid())
  slug             String           @unique
  judul            String
  deskripsi        String?          @db.Text
  tipeOprec        OprecTipe        @default(PANITIA_EVENT)
  tanggalBuka      DateTime
  tanggalTutup     DateTime
  isOpen           Boolean          @default(true)
  kuota            Int              @default(0)
  bannerUrl        String?          @db.Text
  persyaratan      String?          @db.Text
  divisiPilihan    String           @db.Text // JSON string array: ["Acara", "Humas", "Kestari", "Logistik", "Konsumsi", "Pubdok"]
  isPengumumanBuka Boolean          @default(false)
  programKerjaId   String?
  programKerja     ProgramKerja?    @relation(fields: [programKerjaId], references: [id], onDelete: SetNull)
  pendaftar        OprecPendaftar[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("oprec_events")
}

model OprecPendaftar {
  id                   String      @id @default(cuid())
  oprecId              String
  oprec                OprecEvent  @relation(fields: [oprecId], references: [id], onDelete: Cascade)
  nomorRegistrasi      String      @unique // e.g. "REG-2026-0042"
  namaLengkap          String
  nimOrNra             String
  email                String
  phone                String
  fakultasProdi        String?
  angkatan             Int?
  divisiPilihan1       String
  divisiPilihan2       String?
  alasanMemilih        String?     @db.Text
  pengalamanOrganisasi String?     @db.Text
  cvUrl                String?     @db.Text
  ktmUrl               String?     @db.Text
  portofolioUrl        String?     @db.Text
  fotoUrl              String?     @db.Text
  statusTahap          OprecTahap  @default(BERKAS_PENDING)
  divisiDiterima       String?
  jabatanDiterima      String?
  nilaiWawancara       Float       @default(0)
  catatanInterviewer   String?     @db.Text
  isConverted          Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([oprecId, statusTahap])
  @@map("oprec_pendaftar")
}

// ==================== AUTOCRAT-STYLE E-SERTIFIKAT ====================

enum SertifikatKategori {
  PENGURUS
  PANITIA
  PESERTA
  UMUM
}

model SertifikatTemplate {
  id             String                @id @default(cuid())
  namaTemplate   String                // e.g. "Sertifikat Seminar Nasional 2026"
  kategori       SertifikatKategori    @default(UMUM)
  imageUrl       String                @db.Text // URL template background sertifikat
  lebarCanvas    Int                   @default(1920)
  tinggiCanvas   Int                   @default(1080)
  configJson     String                @db.Text // Koordinat & styling teks
  prefixNomor    String                @default("SERT/[NO]/HUBB/[YEAR]")
  sertifikatList SertifikatGenerated[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("sertifikat_templates")
}

model SertifikatGenerated {
  id              String             @id @default(cuid())
  templateId      String
  template        SertifikatTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  nomorSertifikat String             @unique // e.g. "SERT/001/HUBB/2026"
  namaPenerima    String
  sebagai         String             @default("Peserta") // Panitia / Peserta / Pemateri / Pengurus
  keterangan      String?
  issuedAt        DateTime           @default(now())
  outputImageUrl  String?            @db.Text
  createdAt       DateTime           @default(now())

  @@index([templateId, namaPenerima])
  @@map("sertifikat_generated")
}
